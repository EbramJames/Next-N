<UserControl
    x:Class="NextN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:NextN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:NextN.Core.Resx;assembly=NextN.Core"
    xmlns:vms="clr-namespace:NextN.Core.ViewModels;assembly=NextN.Core"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border
        Padding="16,10"
        Background="{DynamicResource NextNSurfaceBg}"
        BorderBrush="{DynamicResource NextNBorderBrush}"
        BorderThickness="0,1,0,0">
        <DockPanel>
            <!-- Real-time Throughput Telemetry (Right) -->
            <Border
                Margin="12,0,0,0"
                Padding="12,6"
                VerticalAlignment="Center"
                Background="{DynamicResource NextNSurfaceElevatedBg}"
                BorderBrush="{DynamicResource NextNBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DockPanel.Dock="Right"
                IsVisible="{Binding SpeedProxyDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="txtSpeedProxyDisplay"
                        HorizontalAlignment="Right"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource NextNCyanBrush}" />
                    <TextBlock
                        x:Name="txtSpeedDirectDisplay"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource NextNTextMuted}" />
                </StackPanel>
            </Border>

            <!-- Local & LAN Inbound Ports Pill (Left) -->
            <Border
                Margin="0,0,12,0"
                Padding="10,6"
                VerticalAlignment="Center"
                Background="{DynamicResource NextNSurfaceElevatedBg}"
                BorderBrush="{DynamicResource NextNBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DockPanel.Dock="Left">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="txtInboundDisplay"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource NextNTextPrimary}" />
                    <TextBlock
                        x:Name="txtInboundLanDisplay"
                        FontSize="11"
                        Foreground="{DynamicResource NextNTextMuted}" />
                </StackPanel>
            </Border>

            <!-- TUN Shield Pill Switch -->
            <Border
                x:Name="spEnableTun"
                Margin="0,0,12,0"
                Padding="10,4"
                VerticalAlignment="Center"
                Background="{DynamicResource NextNSurfaceElevatedBg}"
                BorderBrush="{DynamicResource NextNBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DockPanel.Dock="Left">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Width="15"
                        Height="15"
                        Data="{StaticResource IconShield}"
                        Foreground="{DynamicResource NextNAccentBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource NextNTextPrimary}"
                        Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        HorizontalAlignment="Center"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
            </Border>

            <!-- System Proxy & Routing Selectors -->
            <StackPanel
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="cmbSystemProxy"
                    Width="178"
                    ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                </ComboBox>

                <ComboBox
                    x:Name="cmbRoutings2"
                    Width="190"
                    DisplayMemberBinding="{Binding Remarks}"
                    ItemsSource="{Binding RoutingItems}"
                    ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />
            </StackPanel>

            <!-- Running Server & Availability Click-to-Test -->
            <StackPanel
                VerticalAlignment="Center"
                Cursor="Hand"
                Spacing="2"
                ToolTip.Tip="Click to test server latency">
                <TextBlock
                    x:Name="txtRunningServerDisplay"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource NextNTextPrimary}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="txtRunningInfoDisplay"
                    FontSize="11"
                    Foreground="{DynamicResource NextNTextMuted}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
