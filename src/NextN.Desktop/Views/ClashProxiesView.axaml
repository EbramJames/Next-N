<UserControl
    x:Class="NextN.Desktop.Views.ClashProxiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NextN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:NextN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:NextN.Core.Resx;assembly=NextN.Core"
    xmlns:vms="clr-namespace:NextN.Core.ViewModels;assembly=NextN.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vms:ClashProxiesViewModel"
    Design.DataContext="{x:Static dd:DesignData.ClashProxies}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:DelayColorConverter x:Key="DelayColorConverter" />
    </UserControl.Resources>

    <DockPanel>
        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            Classes="SurfaceCard"
            DockPanel.Dock="Top">
            <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource NextNTextSecondary}"
                    Text="{x:Static resx:ResUI.menuRulemode}" />
                <ComboBox
                    x:Name="cmbRulemode"
                    Width="116"
                    Margin="0,0,14,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource NextNTextSecondary}"
                    Text="{x:Static resx:ResUI.TbSorting}" />
                <ComboBox
                    x:Name="cmbSorting"
                    Width="116"
                    Margin="0,0,12,0">
                    <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDelay}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingName}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDefault}" />
                </ComboBox>

                <Button
                    x:Name="menuProxiesReload"
                    Margin="2,0"
                    Classes="IconButton"
                    ToolTip.Tip="{x:Static resx:ResUI.menuProxiesReload}">
                    <PathIcon Data="{StaticResource SemiIconRefresh}" />
                </Button>

                <Button
                    x:Name="menuGroupProxiesDelaytest"
                    Margin="2,0,14,0"
                    Classes="IconButton"
                    ToolTip.Tip="{x:Static resx:ResUI.menuDelaytest}">
                    <PathIcon
                        Data="{StaticResource SemiIconBolt}"
                        Foreground="{DynamicResource NextNSuccessBrush}" />
                </Button>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource NextNTextSecondary}"
                        Text="{x:Static resx:ResUI.TbAutoRefresh}" />
                    <ToggleSwitch x:Name="togAutoRefresh" Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid ColumnDefinitions="200,10,*">
            <Border Grid.Column="0" Padding="6" Classes="SurfaceCard">
                <ListBox x:Name="lstProxyGroups" ItemsSource="{Binding ProxyGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="10,8"
                                Background="{DynamicResource NextNSurfaceElevatedBg}"
                                BorderBrush="{DynamicResource NextNBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="4">
                                    <DockPanel>
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource NextNAccentBrush}"
                                            Text="{Binding Type}" />
                                        <TextBlock
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource NextNTextPrimary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource NextNTextMuted}"
                                        Text="{Binding Now}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Padding="8" Classes="SurfaceCard">
                <ListBox x:Name="lstProxyDetails" ItemsSource="{Binding ProxyDetails}">
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="menuProxyDelaytest" Header="{x:Static resx:ResUI.menuDelaytest}" />
                            <MenuItem
                                x:Name="menuProxiesSelectActivity"
                                Header="{x:Static resx:ResUI.menuProxiesSelectActivity}"
                                InputGesture="Enter" />
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="184"
                                Margin="2"
                                Padding="10,8"
                                Background="{DynamicResource NextNSurfaceElevatedBg}"
                                BorderBrush="{DynamicResource NextNBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <DockPanel>
                                    <Border
                                        Width="4"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource NextNSuccessBrush}"
                                        CornerRadius="2"
                                        DockPanel.Dock="Left"
                                        IsVisible="{Binding IsActive}" />
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource NextNTextPrimary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <DockPanel>
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Path=Delay, Converter={StaticResource DelayColorConverter}}"
                                                Text="{Binding DelayName}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource NextNTextMuted}"
                                                Text="{Binding Type}" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
