<UserControl
    x:Class="NextN.Desktop.Views.ClashConnectionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:NextN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:NextN.Core.Resx;assembly=NextN.Core"
    xmlns:vms="clr-namespace:NextN.Core.ViewModels;assembly=NextN.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vms:ClashConnectionsViewModel"
    Design.DataContext="{x:Static dd:DesignData.ClashConnections}"
    mc:Ignorable="d">

    <DockPanel>
        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            Classes="SurfaceCard"
            DockPanel.Dock="Top">
            <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBox
                    x:Name="txtHostFilter"
                    Width="230"
                    Margin="0,0,10,0"
                    VerticalContentAlignment="Center"
                    PlaceholderText="{x:Static resx:ResUI.ConnectionsHostFilterTitle}">
                    <TextBox.InnerLeftContent>
                        <PathIcon
                            Width="14"
                            Height="14"
                            Margin="8,0,2,0"
                            Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button
                    x:Name="btnConnectionCloseAll"
                    Margin="2,0"
                    Classes="IconButton"
                    ToolTip.Tip="{x:Static resx:ResUI.menuConnectionCloseAll}">
                    <PathIcon
                        Data="{StaticResource SemiIconClose}"
                        Foreground="{DynamicResource NextNDangerBrush}" />
                </Button>

                <Button
                    x:Name="btnAutofitColumnWidth"
                    Margin="2,0,14,0"
                    Classes="IconButton"
                    ToolTip.Tip="{x:Static resx:ResUI.menuProfileAutofitColumnWidth}">
                    <PathIcon Data="{StaticResource SemiIconExpand}" />
                </Button>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource NextNTextSecondary}"
                        Text="{x:Static resx:ResUI.TbAutoRefresh}" />
                    <ToggleSwitch x:Name="togAutoRefresh" Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border ClipToBounds="True" Classes="SurfaceCard">
            <DataGrid
                x:Name="lstConnections"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ConnectionItems}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="menuConnectionClose" Header="{x:Static resx:ResUI.menuConnectionClose}" />
                        <MenuItem x:Name="menuConnectionCloseAll" Header="{x:Static resx:ResUI.menuConnectionCloseAll}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding Host}"
                        Header="{x:Static resx:ResUI.TbSortingHost}"
                        Tag="Host" />
                    <DataGridTextColumn
                        Width="440"
                        Binding="{Binding Chain}"
                        Header="{x:Static resx:ResUI.TbSortingChain}"
                        Tag="Chain" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Network}"
                        Header="{x:Static resx:ResUI.TbSortingNetwork}"
                        Tag="Network" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Type}"
                        Header="{x:Static resx:ResUI.TbSortingType}"
                        Tag="Type" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding ProcessPath}"
                        Header="{x:Static resx:ResUI.TbSortingProcess}"
                        Tag="ProcessPath" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Elapsed}"
                        Header="{x:Static resx:ResUI.TbSortingTime}"
                        Tag="Elapsed" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
